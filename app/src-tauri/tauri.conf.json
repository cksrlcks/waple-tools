{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "waple tools",
  "version": "../package.json",
  "identifier": "com.cksrlcks.waple-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "waple tools",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MUQ1RTgzM0IzMTI1NTkKUldSWkpURTdnMTRkbFRkaFUvQjVNaUxVYXE2Z2tKT0VoeDE1Q0pNN1N3OUJFUG1NelV6azJlNmIK",
      "endpoints": [
        "https://github.com/cksrlcks/waple-tools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
